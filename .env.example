COMPOSE_PROJECT_NAME=superset
DATA_ROOT=/opt/docker/apache-superset

# Listener. Restrict TCP/8088 in the AWS security group to the reverse-proxy host.
SUPERSET_BIND_ADDRESS=0.0.0.0
SUPERSET_PORT=8088

# Generated by ./init-env.sh. Never commit the resulting .env file.
SUPERSET_SECRET_KEY=__SUPERSET_SECRET_KEY__
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
REDIS_PASSWORD=__REDIS_PASSWORD__
ADMIN_PASSWORD=__ADMIN_PASSWORD__

# Metadata database
POSTGRES_DB=superset
POSTGRES_USER=superset

# Initial Superset administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_FIRSTNAME=Superset
ADMIN_LASTNAME=Admin

# Runtime sizing defaults for a small internal deployment
SERVER_WORKER_AMOUNT=2
SERVER_THREADS_AMOUNT=20
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
WORKER_MAX_REQUESTS=1000
WORKER_MAX_REQUESTS_JITTER=100
CELERY_WORKER_CONCURRENCY=2
REPORTS_WORKER_CONCURRENCY=1

# Alerts & Reports. Set this to the public HTTPS URL exposed by your reverse proxy.
SUPERSET_PUBLIC_URL=https://superset.example.com
ALERT_REPORTS_NOTIFICATION_DRY_RUN=false
SCREENSHOT_LOCATE_WAIT=100
SCREENSHOT_LOAD_WAIT=600

# Email delivery. Leave SMTP_HOST empty only if email notifications are not needed.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_SSL_SERVER_AUTH=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_MAIL_FROM=superset@example.com

# Optional Slack delivery. Webhook delivery needs no global token.
SLACK_API_TOKEN=

# Reverse proxy must supply X-Forwarded-For and X-Forwarded-Proto=https.
ENABLE_PROXY_FIX=true
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_HOURS=8
SUPERSET_LOG_LEVEL=INFO
TZ=UTC
